{
  "manifest_version": 3,
  "name": "Rule34 Filter",
  "version": "3.1.0",
  "description": "Oculta posts com palavras indesejadas no rule34.xxx.",
  "permissions": ["storage"],
  "action": {"default_popup": "popup.html", "default_title": "Rule34 Filter"},
  "browser_specific_settings": {
    "gecko": {
      "id": "rule34-filter@local.extension",
      "strict_min_version": "109.0",
      "data_collection_permissions": {"required": ["none"]}
    }
  },
  "content_scripts": [
    {
      "matches": ["*://rule34.xxx/*", "*://*.rule34.xxx/*"],
      "js": ["settings.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
